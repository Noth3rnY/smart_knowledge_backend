          "mode": "raw",
          "raw": "{\n  \"deviceUuid\": \"{{deviceA}}\",\n  \"requestId\": \"{{syncRequest}}\",\n  \"changes\": [\n    {\n      \"operation\": \"upsert\",\n      \"note\": {\n        \"id\": \"{{noteId}}\",\n        \"baseVersion\": 0,\n        \"title\": \"Flutter 界面渲染与掉帧优化\",\n        \"content\": \"# 性能笔记\\n减少无效重建，优化 SQL 查询。\",\n        \"tags\": [\n          {\n            \"name\": \"Flutter\",\n            \"source\": \"manual\"\n          }\n        ]\n      }\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
