{
  "info": {
    "name": "SmartKnowledgeDB 完整课程演示",
    "description": "先启动 demo 环境，然后按顺序执行。变量持久化支持幂等演示；重新运行整套时清空 username 及 accessToken，预请求脚本将生成新账号与 UUID。密码和令牌仅保存在个人 Postman 变量中，不要导出含真实值的集合。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "username",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "deviceA",
      "value": "",
      "type": "string"
    },
    {
      "key": "deviceB",
      "value": "",
      "type": "string"
    },
    {
      "key": "noteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "activationRequest",
      "value": "",
      "type": "string"
    },
    {
      "key": "syncRequest",
      "value": "",
      "type": "string"
    },
    {
      "key": "conflictRequest",
      "value": "",
      "type": "string"
    },
    {
      "key": "aiRequest",
      "value": "",
      "type": "string"
    },
    {
      "key": "conflictId",
      "value": "",
      "type": "string"
    },
    {
      "key": "backupId",
      "value": "",
      "type": "string"
    },
    {
      "key": "versionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "restoredNoteId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"username\")) {",
          "  pm.collectionVariables.set(\"username\",\"demo_\"+pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g,\"\").slice(0,16));",
          "  pm.collectionVariables.set(\"password\",\"Demo!\"+pm.variables.replaceIn(\"{{$guid}}\"));",
          "  [\"deviceA\",\"deviceB\",\"noteId\",\"activationRequest\",\"syncRequest\",\"conflictRequest\",\"aiRequest\"].forEach(k => pm.collectionVariables.set(k,pm.variables.replaceIn(\"{{$guid}}\")));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 注册账号",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"nickname\": \"课程演示用户\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 设备 A 登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"deviceUuid\": \"{{deviceA}}\",\n  \"deviceName\": \"手机\",\n  \"platform\": \"android\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json().data; pm.collectionVariables.set(\"accessToken\",d.accessToken); pm.collectionVariables.set(\"refreshToken\",d.refreshToken); pm.collectionVariables.set(\"sessionA\",d.deviceId);"
            ]
          }
        }
      ]
    },
